<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while Android starts MomBiz in light mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Android 15 / API 35:
             keep MomBiz out of enforced edge-to-edge mode so the
             3-button navigation bar cannot cover bottom action buttons. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Theme used after Flutter starts. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>

        <!-- Keep the Flutter window inside the Android system bars. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
